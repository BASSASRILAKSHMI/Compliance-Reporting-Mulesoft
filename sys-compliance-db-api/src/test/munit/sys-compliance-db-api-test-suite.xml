    </munit:test>

    <!-- ========================= finalize ========================= -->
    <munit:test name="finalize-happy-path" description="Flags marked, run SUCCESS, bookmark advanced">
        <munit:behavior>
            <munit-tools:mock-when processor="db:update">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Flags -&gt; REPORTED" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[{affectedRows: 3}]" mediaType="application/java" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="db:update">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Run -&gt; SUCCESS" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[{affectedRows: 1}]" mediaType="application/java" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="db:update">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Advance control" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[{affectedRows: 1}]" mediaType="application/java" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="db:select">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Read bookmark" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[[{last_reported_upto: '2026-11-05 21:00:00'}]]" mediaType="application/java" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event>
                <munit:payload mediaType="application/java" value="#[{
                    runId: 'RUN-1', reportType: 'STR', entityCode: 'ENT0091',
                    periodStart: '2026-11-04 21:00:00', periodEnd: '2026-11-05 21:00:00',
                    sequenceNumber: 1, flagMode: 'PENDING', expectedFlagUpdates: 3, advanceControl: true }]" />
            </munit:set-event>
            <flow-ref name="impl-finalize-report" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload.flagsUpdated]" is="#[MunitTools::equalTo(3)]" />
            <munit-tools:assert-that expression="#[payload.lastReportedUpto]" is="#[MunitTools::equalTo('2026-11-05 21:00:00')]" />
        </munit:validation>
    </munit:test>

