    <!-- ========================= archive ========================= -->
    <!-- "Hello" = SGVsbG8= ; SHA-256 = 185f8db32271fe25f561a6fc938b2e264306ec304eda518007d1764826381969 -->
    <munit:test name="archive-stores-new-file" description="Checksum verified, chunk inserted, 201">
        <munit:behavior>
            <munit-tools:mock-when processor="db:select">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Already archived?" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[[{cnt: 0}]]" mediaType="application/java" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="db:insert">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Insert chunk" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[{affectedRows: 1}]" mediaType="application/java" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event>
                <munit:payload mediaType="application/java" value="#[{
                    runId: 'RUN-1', fileType: 'SUBMISSION', fileName: 'ENT0091_STR_20261105_001.csv',
                    checksum: '185f8db32271fe25f561a6fc938b2e264306ec304eda518007d1764826381969',
                    contentBase64: 'SGVsbG8=' }]" />
            </munit:set-event>
            <flow-ref name="impl-archive-file" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.httpStatus]" is="#[MunitTools::equalTo('201')]" />
            <munit-tools:assert-that expression="#[payload.fileSize]" is="#[MunitTools::equalTo(5)]" />
            <munit-tools:verify-call processor="db:insert" times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Insert chunk" />
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>
    </munit:test>

