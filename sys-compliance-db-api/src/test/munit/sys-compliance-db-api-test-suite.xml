    </munit:test>

    <munit:test name="archive-rejects-overwrite" description="NS 6 - existing archive can never be overwritten" expectedErrorType="APP:CONFLICT">
        <munit:behavior>
            <munit-tools:mock-when processor="db:select">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Already archived?" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[[{cnt: 1}]]" mediaType="application/java" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
