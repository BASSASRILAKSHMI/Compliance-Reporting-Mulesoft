                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event>
                <munit:payload value="#[{recordCount: 3, runStatus: 'FAILED'}]" mediaType="application/java" />
                <munit:attributes value="#[{uriParams: {runId: 'RUN-X'}}]" />
            </munit:set-event>
            <flow-ref name="impl-update-run" />
        </munit:execution>
    </munit:test>

