<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

    <munit:config name="sys-compliance-db-api-test-suite.xml" />

    <!-- ========================= health ========================= -->
    <munit:test name="health-returns-up" description="DB reachable -> UP">
        <munit:behavior>
            <munit-tools:mock-when processor="db:select">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="SELECT 1" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[[{ok: 1}]]" mediaType="application/java" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="impl-health" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload.database]" is="#[MunitTools::equalTo('UP')]" />
        </munit:validation>
    </munit:test>

    <!-- ========================= control ========================= -->
    <munit:test name="control-found" description="Bookmark is returned in camelCase">
        <munit:behavior>
            <munit-tools:mock-when processor="db:select">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Select bookmark" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java"
                        value="#[[{report_type: 'STR', entity_code: 'ENT0091', last_reported_upto: '2026-11-04 21:00:00', last_successful_run: null, last_sequence_number: 0, updated_at: '2026-11-09 21:40:12'}]]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event>
                <munit:attributes value="#[{uriParams: {reportType: 'STR', entityCode: 'ENT0091'}}]" />
            </munit:set-event>
            <flow-ref name="impl-get-control" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload.lastReportedUpto]" is="#[MunitTools::equalTo('2026-11-04 21:00:00')]" />
            <munit-tools:assert-that expression="#[payload.lastSequenceNumber]" is="#[MunitTools::equalTo(0)]" />
        </munit:validation>
    </munit:test>

    <munit:test name="control-not-found" description="Unknown report -> APP:NOT_FOUND" expectedErrorType="APP:NOT_FOUND">
        <munit:behavior>
            <munit-tools:mock-when processor="db:select">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Select bookmark" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[[]]" mediaType="application/java" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event>
                <munit:attributes value="#[{uriParams: {reportType: 'CTR', entityCode: 'ENT0091'}}]" />
            </munit:set-event>
            <flow-ref name="impl-get-control" />
        </munit:execution>
    </munit:test>

    <!-- ========================= flag page ========================= -->
    <munit:test name="flag-page-has-more-and-cursor" description="limit+1 rows -> hasMore, cursor = last returned row, placeholder customer flagged">
        <munit:behavior>
            <munit-tools:mock-when processor="db:select">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Select flag page" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java" value="#[[
  {flag_seq: 1, transaction_id: 'TXN-1', transaction_datetime: '2026-11-05 14:22:07', account_number: '00214578', customer_id: 'CUST-77219', customer_name: 'Meena Raghavan', customer_type: 'INDIVIDUAL', customer_missing: 0, transaction_type: 'CARD_PAYMENT', channel: 'ONLINE', currency: 'INR', amount: 248500.00, counterparty_name: 'Global Gadgets Online', counterparty_country: 'SG', flag_code: 'FLG-HIGH-VALUE', flag_reason: 'r', flagged_at: '2026-11-05 14:22:09', reviewed_by: 'RISK_ANALYST_04', review_status: 'CONFIRMED'},
  {flag_seq: 2, transaction_id: 'TXN-2', transaction_datetime: '2026-11-05 16:40:55', account_number: '00219004', customer_id: 'CUST-99999', customer_name: 'UNKNOWN_CUSTOMER', customer_type: 'UNKNOWN', customer_missing: 1, transaction_type: 'WIRE_TRANSFER', channel: 'BRANCH', currency: 'INR', amount: 1150000.00, counterparty_name: 'Orient Trading FZE', counterparty_country: 'AE', flag_code: 'FLG-CROSS-BORDER', flag_reason: 'r', flagged_at: '2026-11-05 16:41:02', reviewed_by: 'RISK_ANALYST_02', review_status: 'CONFIRMED'},
  {flag_seq: 3, transaction_id: 'TXN-3', transaction_datetime: '2026-11-05 18:05:12', account_number: '00221876', customer_id: 'CUST-66207', customer_name: 'Sunrise Exports Pvt Ltd', customer_type: 'CORPORATE', customer_missing: 0, transaction_type: 'CASH_DEPOSIT', channel: 'BRANCH', currency: 'INR', amount: 980000.00, counterparty_name: 'Self', counterparty_country: 'IN', flag_code: 'FLG-STRUCTURING', flag_reason: 'r', flagged_at: '2026-11-05 18:05:20', reviewed_by: 'RISK_ANALYST_07', review_status: 'CONFIRMED'}
]]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event>
                <munit:attributes value="#[{queryParams: {periodStart: '2026-11-04 21:00:00', periodEnd: '2026-11-05 21:00:00', limit: '2'}}]" />
            </munit:set-event>
            <flow-ref name="impl-get-flag-page" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload.count]" is="#[MunitTools::equalTo(2)]" />
            <munit-tools:assert-that expression="#[payload.hasMore]" is="#[MunitTools::equalTo(true)]" />
            <munit-tools:assert-that expression="#[payload.nextCursor.afterTransactionId]" is="#[MunitTools::equalTo('TXN-2')]" />
            <munit-tools:assert-that expression="#[payload.records[1].customerMissing]" is="#[MunitTools::equalTo(true)]" />
            <munit-tools:assert-that expression="#[payload.records[0].flaggedAt]" is="#[MunitTools::equalTo('2026-11-05T14:22:09+05:30')]" />
        </munit:validation>
    </munit:test>

    <munit:test name="flag-page-last-page" description="fewer rows than limit -> no cursor">
        <munit:behavior>
            <munit-tools:mock-when processor="db:select">
