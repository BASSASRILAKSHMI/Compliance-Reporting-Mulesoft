        <munit:execution>
            <munit:set-event>
                <munit:attributes value="#[{queryParams: {periodStart: '2026-11-05 21:00:00', periodEnd: '2026-11-06 21:00:00'}}]" />
            </munit:set-event>
            <flow-ref name="impl-get-flag-page" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload.count]" is="#[MunitTools::equalTo(0)]" />
            <munit-tools:assert-that expression="#[payload.hasMore]" is="#[MunitTools::equalTo(false)]" />
            <munit-tools:assert-that expression="#[payload.nextCursor]" is="#[MunitTools::nullValue()]" />
        </munit:validation>
    </munit:test>

    <!-- ========================= summary ========================= -->
    <munit:test name="flag-summary-totals-and-breakdown" description="Aggregate + per-flag breakdown">
        <munit:behavior>
            <munit-tools:mock-when processor="db:select">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Aggregate totals" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java"
                        value="#[[{record_count: 3, total_amount: 2378500.00, customer_count: 3, pending_count: 3}]]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="db:select">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Breakdown by flag code" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java"
                        value="#[[{flag_code: 'FLG-CROSS-BORDER', cnt: 1, amount: 1150000.00}, {flag_code: 'FLG-HIGH-VALUE', cnt: 1, amount: 248500.00}, {flag_code: 'FLG-STRUCTURING', cnt: 1, amount: 980000.00}]]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event>
                <munit:attributes value="#[{queryParams: {periodStart: '2026-11-04 21:00:00', periodEnd: '2026-11-05 21:00:00'}}]" />
            </munit:set-event>
            <flow-ref name="impl-get-flag-summary" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload.recordCount]" is="#[MunitTools::equalTo(3)]" />
            <munit-tools:assert-that expression="#[payload.totalAmount]" is="#[MunitTools::equalTo(2378500.00)]" />
            <munit-tools:assert-that expression="#[sizeOf(payload.byFlag)]" is="#[MunitTools::equalTo(3)]" />
        </munit:validation>
    </munit:test>

    <!-- ========================= late flags ========================= -->
    <munit:test name="late-flags-listed" description="Pending flags before the bookmark are returned">
        <munit:behavior>
            <munit-tools:mock-when processor="db:select">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Pending flags before bookmark" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload mediaType="application/java"
                        value="#[[{flag_seq: 23, transaction_id: 'TXN-99121500', flag_code: 'FLG-CROSS-BORDER', flagged_at: '2026-11-05 19:45:30', amount: 1475000.00}]]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event>
                <munit:attributes value="#[{queryParams: {}}]" />
            </munit:set-event>
            <flow-ref name="impl-get-late-flags" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload[0].transactionId]" is="#[MunitTools::equalTo('TXN-99121500')]" />
        </munit:validation>
    </munit:test>

    <!-- ========================= runs ========================= -->
    <munit:test name="patch-run-rejects-success" description="SUCCESS only via finalize" expectedErrorType="APP:BAD_REQUEST">
        <munit:execution>
            <munit:set-event>
                <munit:payload value="#[{runStatus: 'SUCCESS'}]" mediaType="application/json" />
                <munit:attributes value="#[{uriParams: {runId: 'RUN-1'}}]" />
            </munit:set-event>
            <flow-ref name="impl-update-run" />
        </munit:execution>
    </munit:test>

    <munit:test name="patch-run-unknown-run" description="0 rows updated -> APP:NOT_FOUND" expectedErrorType="APP:NOT_FOUND">
        <munit:behavior>
            <munit-tools:mock-when processor="db:update">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Update run" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
